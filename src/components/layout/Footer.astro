---
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const currentYear = new Date().getFullYear();

const categoryLinks = [
  { label: t('nav.swimwear'), href: lang === 'en' ? '/collection/swimwear' : '/ar/collection/swimwear' },
  { label: t('nav.agarwood'), href: lang === 'en' ? '/collection/agarwood' : '/ar/collection/agarwood' },
  { label: t('nav.candle'), href: lang === 'en' ? '/collection/candle' : '/ar/collection/candle' },
];

const infoLinks = [
  { label: t('footer.brandStory'), href: lang === 'en' ? '/about' : '/ar/about' },
  { label: t('footer.contactUs'), href: lang === 'en' ? '/contact' : '/ar/contact' },
  { label: t('footer.faq'), href: lang === 'en' ? '/faq' : '/ar/faq' },
];
---

<footer class="bg-brand-dark text-white">
  <div class="container-custom py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <h3 class="font-serif-cn text-xl font-medium mb-4">fianser</h3>
        <p class="text-sm text-gray-400 mb-4 max-w-md" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
          {t('footer.description')}
        </p>
        <div class="flex gap-4">
          <a href="#" class="text-gray-400 hover:text-white transition-colors" aria-label="Weibo">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.194 14.266c0 3.052-3.818 5.534-8.526 5.534-4.708 0-8.526-2.482-8.526-5.534s3.818-5.534 8.526-5.534c4.708 0 8.526 2.482 8.526 5.534z"/>
            </svg>
          </a>
          <a href="#" class="text-gray-400 hover:text-white transition-colors" aria-label="WeChat">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8.691 2.187C3.891 2.187 0 5.679 0 10.089c0 2.553 1.364 4.809 3.469 6.269-.114.411-.309 1.381-.354 1.627-.056.308.109.304.271.22.143-.073 1.861-1.081 2.623-1.525.685.149 1.411.229 2.16.229 4.8 0 8.691-3.492 8.691-7.902S13.491 2.187 8.691 2.187z"/>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-medium mb-4 text-sm uppercase tracking-wider" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
          {t('footer.products')}
        </h4>
        <ul class="space-y-2">
          {categoryLinks.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-sm text-gray-400 hover:text-white transition-colors"
                dir={lang === 'ar' ? 'rtl' : 'ltr'}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-medium mb-4 text-sm uppercase tracking-wider" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
          {t('footer.info')}
        </h4>
        <ul class="space-y-2">
          {infoLinks.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-sm text-gray-400 hover:text-white transition-colors"
                dir={lang === 'ar' ? 'rtl' : 'ltr'}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-800">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-xs text-gray-500">
          © {currentYear} fianser. {t('footer.rights')}
        </p>
        <div class="flex gap-6">
          <a href={lang === 'en' ? '/privacy' : '/ar/privacy'} class="text-xs text-gray-500 hover:text-gray-400 transition-colors">
            {t('footer.privacy')}
          </a>
          <a href={lang === 'en' ? '/shipping' : '/ar/shipping'} class="text-xs text-gray-500 hover:text-gray-400 transition-colors">
            {t('footer.shipping')}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
