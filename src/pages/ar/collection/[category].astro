---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Container from '../../../components/layout/Container.astro';
import ProductCard from '../../../components/product/ProductCard.astro';
import { getProductsByCategory, getCategoryLabel } from '../../../utils/products';
import { useTranslations, type Lang } from '../../../i18n/utils';

export async function getStaticPaths() {
  return [
    { params: { category: 'swimwear' } },
    { params: { category: 'bracelet' } },
    { params: { category: 'agarwood' } },
  ];
}

const { category } = Astro.params;
const lang: Lang = 'ar';
const t = useTranslations(lang);

const products = await getProductsByCategory(category || '');
const categoryLabel = getCategoryLabel(category || '');

const categoryInfo: Record<string, { title: string; description: string; image: string }> = {
  swimwear: {
    title: t('categories.swimwear.title'),
    description: t('categories.swimwear.description'),
    image: '/images/brand/category-swimwear.webp',
  },
  bracelet: {
    title: t('categories.bracelet.title'),
    description: t('categories.bracelet.description'),
    image: '/images/brand/category-bracelet.webp',
  },
  agarwood: {
    title: t('categories.agarwood.title'),
    description: t('categories.agarwood.description'),
    image: '/images/brand/category-agarwood.webp',
  },
};

const info = categoryInfo[category || 'swimwear'];
---

<BaseLayout title={`${info.title} - fianser`} description={info.description} lang={lang}>
  <Header slot="header" lang={lang} />
  
  <section class="relative py-16 md:py-24">
    <div class="absolute inset-0 h-64 md:h-80">
      <img 
        src={info.image} 
        alt={info.title}
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-bg/80 to-brand-bg"></div>
    </div>
    
    <Container class="relative z-10 pt-32 md:pt-40">
      <div class="text-center mb-12">
        <h1 class="font-serif-cn text-4xl md:text-5xl font-medium text-brand-text mb-4">
          {info.title}
        </h1>
        <p class="text-brand-text-secondary max-w-2xl mx-auto">
          {info.description}
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-24 md:pb-32">
    <Container>
      {products.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {products.map((product) => (
            <ProductCard
              title={product.data.title}
              slug={product.data.slug}
              category={product.data.category}
              image={product.data.images[0]}
              price={product.data.price}
              tags={product.data.tags}
              featured={product.data.featured}
              lang={lang}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-brand-text-secondary">
            No products in this category
          </p>
        </div>
      )}
    </Container>
  </section>

  <Footer slot="footer" lang={lang} />
</BaseLayout>
