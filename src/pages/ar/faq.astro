---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Container from '../../components/layout/Container.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

const lang: Lang = 'ar';
const t = useTranslations(lang);

const faqs = [
  {
    question: 'How to purchase fianser products?',
    answer: 'You can purchase products through our Tmall store. This website showcases product information, please visit Tmall for purchasing.',
  },
  {
    question: 'Shipping time?',
    answer: 'Generally, orders ship within 48 hours. Please refer to Tmall store announcements for specific shipping times.',
  },
  {
    question: 'Return and exchange policy?',
    answer: 'We support 7-day hassle-free returns and exchanges (items must remain original, unused, and unopened). Please refer to Tmall store return policy for details.',
  },
  {
    question: 'How to maintain agarwood products?',
    answer: 'Avoid contact with water, sweat, and chemicals. Store in a cool, dry place. Check storage condition regularly. Recommended to use sealed bags or boxes.',
  },
  {
    question: 'Can bracelets get wet?',
    answer: 'Agarwood and wooden bracelets are not recommended to get wet, as it may cause cracking or discoloration. Remove when washing hands or bathing, and avoid contact with chemicals.',
  },
  {
    question: 'How to wash swimwear?',
    answer: 'Hand wash recommended, water temperature not exceeding 30°C. Use neutral detergent. Do not bleach. Dry in shade, avoid direct sunlight.',
  },
];
---

<BaseLayout title={`الأسئلة الشائعة - fianser`} lang={lang}>
  <Header slot="header" lang={lang} />
  
  <section class="py-16 md:py-24">
    <Container>
      <div class="max-w-3xl mx-auto">
        <h1 class="font-serif-cn text-4xl md:text-5xl font-medium text-brand-text mb-8 text-center">
          {t('faq.title')}
        </h1>
        
        <div class="mt-12 space-y-4" dir="rtl">
          {faqs.map((faq) => (
            <details class="group border border-brand-border rounded-sm overflow-hidden">
              <summary class="flex items-center justify-between p-5 cursor-pointer bg-white hover:bg-brand-bg transition-colors">
                <span class="font-medium text-brand-text pr-4">
                  {faq.question}
                </span>
                <svg 
                  xmlns="http://www.w3.org/2000/svg" 
                  width="20" 
                  height="20" 
                  viewBox="0 0 24 24" 
                  fill="none" 
                  stroke="currentColor" 
                  stroke-width="2" 
                  stroke-linecap="round" 
                  stroke-linejoin="round"
                  class="text-brand-text-secondary transition-transform group-open:rotate-180"
                >
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="p-5 pt-0 bg-white border-t border-brand-border">
                <p class="text-brand-text-secondary leading-relaxed">
                  {faq.answer}
                </p>
              </div>
            </details>
          ))}
        </div>
        
        <div class="mt-12 text-center">
          <p class="text-brand-text-secondary mb-4">
            {t('faq.notFound')}
          </p>
          <a 
            href="/ar/contact" 
            class="inline-flex items-center gap-2 text-brand-accent hover:text-brand-accent-hover transition-colors"
          >
            {t('faq.contactLink')}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </Container>
  </section>

  <Footer slot="footer" lang={lang} />
</BaseLayout>
