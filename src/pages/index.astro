---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/layout/Container.astro';
import Button from '../components/ui/Button.astro';
import ProductCard from '../components/product/ProductCard.astro';
import { getFeaturedProducts } from '../utils/products';
import { useTranslations, type Lang } from '../i18n/utils';

const lang: Lang = 'en';
const t = useTranslations(lang);

const featuredProducts = await getFeaturedProducts();

const categories = [
  { 
    key: 'swimwear', 
    title: t('categories.swimwear.title'),
    description: t('categories.swimwear.description'),
    image: '/images/brand/category-swimwear.webp'
  },
  { 
    key: 'bracelet', 
    title: t('categories.bracelet.title'),
    description: t('categories.bracelet.description'),
    image: '/images/brand/category-bracelet.webp'
  },
  { 
    key: 'agarwood', 
    title: t('categories.agarwood.title'),
    description: t('categories.agarwood.description'),
    image: '/images/brand/category-agarwood.webp'
  },
];
---

<BaseLayout title="fianser - Premium Lifestyle Brand" lang={lang}>
  <Header slot="header" lang={lang} />
  
  <section class="relative min-h-screen flex items-center justify-center bg-brand-text">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-text/50 to-brand-text"></div>
    <img 
      src="/images/brand/hero.webp" 
      alt="fianser brand"
      class="absolute inset-0 w-full h-full object-cover opacity-40"
    />
    <Container class="relative z-10 text-center text-white">
      <h1 class="font-serif-cn text-4xl md:text-6xl lg:text-7xl font-medium mb-6 opacity-0 animate-fade-in">
        {t('hero.title')}
      </h1>
      <p class="text-lg md:text-xl text-gray-300 mb-8 max-w-2xl mx-auto opacity-0 animate-fade-in animation-delay-100">
        {t('hero.subtitle')}
      </p>
      <p class="text-sm md:text-base text-gray-400 mb-12 max-w-xl mx-auto opacity-0 animate-fade-in animation-delay-200">
        {t('hero.tagline')}
      </p>
      <div class="opacity-0 animate-fade-in animation-delay-300">
        <Button href="/collection/swimwear" size="lg">
          {t('hero.cta')}
        </Button>
      </div>
    </Container>
  </section>

  <section class="py-24 md:py-32">
    <Container>
      <div class="text-center mb-16">
        <h2 class="font-serif-cn text-3xl md:text-4xl font-medium text-brand-text mb-4">
          {t('categories.title')}
        </h2>
        <p class="text-brand-text-secondary max-w-2xl mx-auto">
          {t('categories.subtitle')}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {categories.map((cat) => (
          <a 
            href={`/collection/${cat.key}`}
            class="group relative overflow-hidden rounded-sm aspect-[4/5]"
          >
            <img 
              src={cat.image} 
              alt={cat.title}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-text via-brand-text/50 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="font-serif-cn text-2xl font-medium mb-2">{cat.title}</h3>
              <p class="text-sm text-gray-300">{cat.description}</p>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  {featuredProducts.length > 0 && (
    <section class="py-24 md:py-32 bg-brand-bg">
      <Container>
        <div class="text-center mb-16">
          <h2 class="font-serif-cn text-3xl md:text-4xl font-medium text-brand-text mb-4">
            {t('featured.title')}
          </h2>
          <p class="text-brand-text-secondary max-w-2xl mx-auto">
            {t('featured.subtitle')}
          </p>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredProducts.slice(0, 6).map((product) => (
            <ProductCard
              title={product.data.title}
              slug={product.data.slug}
              category={product.data.category}
              image={product.data.images[0]}
              price={product.data.price}
              tags={product.data.tags}
              featured={product.data.featured}
              lang={lang}
            />
          ))}
        </div>
        
        <div class="text-center mt-12">
          <Button href="/collection/swimwear" variant="outline">
            {t('featured.viewAll')}
          </Button>
        </div>
      </Container>
    </section>
  )}

  <section class="py-24 md:py-32 bg-brand-text text-white">
    <Container>
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-serif-cn text-3xl md:text-4xl font-medium mb-6">
          {t('about.title')}
        </h2>
        <p class="text-gray-300 text-lg leading-relaxed mb-8">
          {t('about.description')}
        </p>
        <Button href="/about" variant="outline">
          {t('about.learnMore')}
        </Button>
      </div>
    </Container>
  </section>

  <Footer slot="footer" lang={lang} />
</BaseLayout>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }
  
  .animation-delay-100 {
    animation-delay: 0.1s;
  }
  
  .animation-delay-200 {
    animation-delay: 0.2s;
  }
  
  .animation-delay-300 {
    animation-delay: 0.3s;
  }
</style>
