---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/layout/Container.astro';
import { useTranslations, type Lang } from '../i18n/utils';

const lang: Lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout title="Brand Story - fianser" lang={lang}>
  <Header slot="header" lang={lang} />
  
  <section class="py-16 md:py-24">
    <Container>
      <div class="max-w-4xl mx-auto">
        <h1 class="font-serif-cn text-4xl md:text-5xl font-medium text-brand-text mb-8 text-center">
          {t('brand.title')}
        </h1>
        
        <div class="aspect-video rounded-sm overflow-hidden mb-12 bg-brand-border">
          <img 
            src="/images/brand/about-hero.webp" 
            alt="fianser brand story"
            class="w-full h-full object-cover"
          />
        </div>
        
        <div class="prose prose-lg max-w-none">
          <div class="text-brand-text-secondary leading-relaxed space-y-6">
            <p class="text-xl">
              {t('about.description')}
            </p>
            
            <h2 class="font-serif-cn text-2xl font-medium text-brand-text mt-12 mb-6">
              {t('brand.quality')}
            </h2>
            
            <p>
              We source premium materials globally, partnering with experienced artisans. 
              Every product undergoes rigorous quality control for materials, craftsmanship, and details.
            </p>
            
            <h2 class="font-serif-cn text-2xl font-medium text-brand-text mt-12 mb-6">
              {t('brand.design')}
            </h2>
            
            <p>
              Simple yet sophisticated, restrained yet warm. Our design philosophy removes excess decoration, 
              presenting the inherent beauty of materials. Generous white space, soft tones, refined details—this is fianser's aesthetic language.
            </p>
            
            <h2 class="font-serif-cn text-2xl font-medium text-brand-text mt-12 mb-6">
              {t('brand.vision')}
            </h2>
            
            <p>
              We hope fianser becomes your partner in quality living. Not a fast-moving trend chaser, 
              but a lasting companion that carries memories.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <Footer slot="footer" lang={lang} />
</BaseLayout>
